@article{ch1-the-insecurity-of-ECDSA,
  title = {The Insecurity of the Elliptic Curve Digital Signature Algorithm with Partially Known Nonces},
  author = {PPhong Q. Nguyen and Igor E. Shparlinaki},
  year = {2003},
  journal = {Springer Nature Link},
  url = {https://link.springer.com/article/10.1023/A:1025436905711},
  doi = {https://doi.org/10.1023/A:1025436905711},
  chapter = {Abstract},
  note = {Nguyen and Shparlinski have recently presented a polynomial-time algorithm that provably recovers the signer's secret DSA key when a few consecutive bits of the random nonces k (used at each signature generation) are known for a number of DSA signatures at most linear in log q (q denoting as usual the small prime of DSA), under a reasonable assumption on the hash function used in DSA. }
}

